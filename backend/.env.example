# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# LLM Provider Configuration
# Supported providers: "gemini" | "mock"
LLM_PROVIDER=gemini

# Google Gemini API Configuration
# Obtain your free API key at: https://aistudio.google.com/
# NEVER commit your actual API key to version control.
GEMINI_API_KEY=replace_with_your_api_key

# Recommended Gemini Models:
# - gemini-2.5-flash (Fastest, latest standard multimodal model with generous free tier)
# - gemini-1.5-flash (Highly stable, fast & cost-efficient)
# - gemini-1.5-pro   (Best reasoning for complex tasks)
GEMINI_MODEL=gemini-2.5-flash

# Mock Provider Configuration (Optional, for offline development)
MOCK_MODEL=mock-assistant-v1
